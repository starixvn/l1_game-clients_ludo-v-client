
CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold:  { value: 0.5 }
        # Custom Properties
        stripeColor:     { value: [1.0, 1.0, 1.0, 0.5], editor: { type: color } }
        stripeRatio:     { value: 0.5, editor: { tooltip: "Width stripe (0.0 - 1.0)", range: [0.001, 0.999] } }
        stripeSpeed:     { value: 1.0, editor: { tooltip: "Animation speed" } }
        tiling:          { value: 10.0, editor: { tooltip: "Density" } }
        smoothness:      { value: 1.0, range: [0.0, 5.0]  }
        backgroundColor: { value: [0.0, 0.0, 0.0, 1.0], editor: { type: color } }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  #extension GL_OES_standard_derivatives : enable
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  #include <builtin/uniforms/cc-global> 

  in vec4 color;
  in vec2 uv0;

  #if USE_TEXTURE
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  uniform StripeConstants {
    vec4 stripeColor;
    vec4 backgroundColor;
    float stripeRatio;
    float stripeSpeed;
    float tiling;
    float smoothness;
  };

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    #endif
    o *= color;

    // --- Main logic ---

    // Caculate pattern
    // uv0.x - uv0.y to make / or uv0.x + uv0.y to make \
    // Minus cc_time to move from right to left
    float pos = (uv0.x - uv0.y) * 0.5 * tiling - (cc_time.x * stripeSpeed * 0.5);

    float patternDist = abs(fract(pos) - 0.5) * 2.0;


    float edgeWidth = fwidth(pos) * smoothness;

    edgeWidth = max(edgeWidth, 0.0001);

    // Create mask with smoothstep
    float stripeMask = 1.0 - smoothstep(stripeRatio - edgeWidth, stripeRatio + edgeWidth, patternDist);


    o.rgb = backgroundColor.rgb;
    o.rgb = mix(o.rgb, stripeColor.rgb, stripeMask * stripeColor.a * step(0.01, o.a));
    
    ALPHA_TEST(o);
    return o;
  }
}%